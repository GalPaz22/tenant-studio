function toolLabel(e){
 const hint=e.args?.query||e.args?.contains||e.args?.field||e.args?.target||e.args?.from||e.args?.term||e.args?.url||e.args?.path||'';
 return (TOOL_NAMES[e.name]||e.name)+(hint?` ״${hint}״`:'')+'…';
}


  const c=await api('/projects/'+project.id+'/products/'+encodeURIComponent(productId));const url=safeUrl(c.url);
  root.replaceChildren(
   c.image&&safeUrl(c.image)?el('img',{src:safeUrl(c.image),alt:''}):null,
   el('h3',{},c.title||c.name),
   el('p',{class:'meta'},[c.id,c.sku,c.price!=null?'₪'+c.price:null,c.stockStatus==='instock'?'במלאי':c.stockStatus,c.hidden?'מוסתר':null].filter(Boolean).join(' · ')),
   url?el('a',{href:url,target:'_blank',rel:'noreferrer',class:'link'},'צפה בעמוד המוצר באתר החנות ↗'):null,
   el('table',{class:'specs'},Object.entries(c.specifications||{}).map(([k,v])=>el('tr',{},el('th',{},k),el('td',{},String(v))))),
   c.categories?.length?el('p',{},el('b',{},'קטגוריות: '),c.categories.join(' · ')):null,
   c.tags?.length?el('p',{},el('b',{},'תגיות: '),c.tags.join(' · ')):null,
   c.description?el('p',{class:'description'},c.description):null,
   el('button',{type:'button',class:'ghost',onclick:()=>{attached={product:{id:c.id,title:c.title}};renderAttached();$('message').value=`לגבי המוצר ״${c.title}״ (מזהה ${c.id}): `;$('message').focus();}},'שאל את האייג׳נט על המוצר הזה')
  );
 }catch(err){root.replaceChildren(el('p',{class:'error'},err.message));}
}

function renderVersions(){
 const rules=$('rules'),versions=$('versions');rules.replaceChildren();versions.replaceChildren();if(!project?.revisions?.length)return;
 const pr=project.revisions.at(-1).profile||{};
 const section=(title,items)=>el('details',{open:items.length<=6},el('summary',{},`${title} (${items.length})`),items.length?el('ul',{},items):el('p',{class:'meta'},'אין כללים פעילים'));
 rules.append(
  el('h3',{},'כללי החיפוש הפעילים במודול'),
  section('תיקוני כתיב (queryAliases)',Object.entries(pr.queryAliases||{}).map(([f,t])=>el('li',{},`${f} ← ${t}`))),
  section('מילים נרדפות (semanticAliases)',Object.entries(pr.semanticAliases||{}).map(([f,t])=>el('li',{},`${f} → ${t.join(', ')}`))),
  section('מונחים מקושרים למוצרים (scopedAliases)',(pr.scopedAliases||[]).map(r=>el('li',{},`${r.term} → ${r.productIds.length} מוצרים`))),
  section('תגיות ומאפיינים (tagDefinitions)',Object.entries(pr.tagDefinitions||{}).map(([k,v])=>el('li',{},`${k}${v.queryAliases?.length?' ('+v.queryAliases.join(', ')+')':''}`)))
 );
 versions.append(el('h3',{},'היסטוריית גרסאות ושינויים'));
 for(const r of [...project.revisions].reverse().slice(0,25))versions.append(el('div',{class:'version'+(r.number===project.revisions.length?' current':'')},
  el('b',{},'גרסה '+r.number),el('small',{},r.createdAt?new Date(r.createdAt).toLocaleString('he-IL'):''),r.note?el('p',{},r.note):null,
  r.changes?.length?el('ul',{},r.changes.slice(0,6).map(c=>el('li',{},typeof c==='string'?c:String(c)))):null,
  r.number!==project.revisions.length?el('button',{type:'button',class:'link',onclick:()=>rollback(r.number)},'שחזר לגרסה זו'):el('span',{class:'pill'},'גרסה פעילה')
 ));
}

async function rollback(number){
 if(busy||!project||!number)return;if(!confirm(`לחזור לכללי גרסה ${number}? הפעולה נשמרת כגרסה חדשה.`))return;
 try{await api('/projects/'+project.id+'/rollback',{revision:number});project=await api('/projects/'+project.id);renderClient();toast('שוחזרה גרסה '+number);}catch(err){toast(err.message);}
}

// ---------- start ----------
(async()=>{
 try{
  const list=await loadClients();
  const wanted=new URL(location.href).searchParams.get('tenant')||localStorage.getItem('studio-tenant');
  const first=list.find(c=>c.id===wanted)||list.find(c=>c.products);
  if(first)await openClient(first.id);else renderClient();
  try{
   const raw=sessionStorage.getItem('studio-handoff');
   if(raw&&project){
    sessionStorage.removeItem('studio-handoff');
    const h=JSON.parse(raw);
    if(h.query){attached={query:h.query,total:h.total,results:h.results};renderAttached();runSearch(h.query);}
    if(h.message)$('message').value=h.message;$('message').focus();
   }
  }catch{}
 }catch(err){toast(err.message);}
})();
